@page "{id}"
@model fixflow.web.Pages.Tickets.DetailsModel
@{
    var isResident = User.IsInRole("Resident") || User.IsInRole("Pending");
    var ticketsHomeHref = isResident ? "/Dashboard" : "/Tickets/List";
    var ticketsHomeLabel = isResident ? "Back to My Tickets" : "Back to Tickets";
    ViewData["Title"] = $"Ticket #{Model.Ticket.DisplayId} - FixFlow";
    ViewData["HideNav"] = true;
    ViewData["ActiveNav"] = "Tickets";
    ViewData["BreadcrumbPath"] = "Operations";
    ViewData["BreadcrumbTitle"] = $"Ticket #{Model.Ticket.DisplayId}";
}

@section Styles {
    <link rel="stylesheet" href="~/css/tickets.css" />
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.js-auto-submit-select').forEach(function (select) {
                select.addEventListener('change', function () {
                    if (select.form) {
                        select.form.submit();
                    }
                });
            });
        });
    </script>
}

<div class="app-shell">
    @await Html.PartialAsync("_AppSidebar")

    <main class="main ref-main details-main">
        @await Html.PartialAsync("_Topbar")
        <div class="ref-page tickets-hub details-page">
            <div class="ph">
                <div>
                    <div class="ph-bc">Request details</div>
                    <div class="ph-s">Details and updates for this request.</div>
                </div>
                <div class="details-actions">
                    <a href="@ticketsHomeHref" class="btn btn-s"><i class="bi bi-arrow-left"></i> @ticketsHomeLabel</a>
                </div>
            </div>


            <div class="details-grid">
                <div>
                    <section class="tsec details-card">
                        <div class="tsec-hd">
                            <span class="ct">Request Overview</span>
                        </div>
                        <div class="details-card-body">
                        <div class="ticket-title">@Model.Ticket.Title</div>

                        <div class="ticket-meta">
                            <div class="meta-item">
                                <span class="meta-label">Status</span>
                                @{
                                    var detailsStatusClass = Model.Ticket.Status.ToLower().Replace(" ", "");
                                    var detailsStatusIcon = detailsStatusClass switch
                                    {
                                        "submitted" => "circle",
                                        "inreview" => "clock",
                                        "assigned" => "user-check",
                                        "inprogress" => "loader",
                                        "onhold" => "pause-circle",
                                        "completed" => "check-circle",
                                        "cancelled" => "x-circle",
                                        _ => "circle-dot"
                                    };
                                }
                                @if ((Model.UserRole == "Admin" || Model.UserRole == "Manager" || Model.UserRole == "Technician")
                                    && !string.IsNullOrWhiteSpace(Model.Ticket.CurrentAssigneeId)
                                    && Model.AvailableStatuses.Count > 0)
                                {
                                    <form method="post" asp-page-handler="UpdateStatus" asp-route-ticketId="@Model.Ticket.Id" class="ff-status-form meta-value">
                                        <select asp-for="SelectedStatusCode" asp-items="Model.AvailableStatuses" class="fsel ff-status-select js-status-select" aria-label="Ticket status"></select>
                                    </form>
                                }
                                else
                                {
                                    <div class="meta-value ff-status-inline">
                                        <span>@Model.Ticket.Status</span>
                                        <i class="status-icon @detailsStatusClass" data-lucide="@detailsStatusIcon" title="@Model.Ticket.Status"></i>
                                    </div>
                                }
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">Priority</span>
                                @if (Model.UserRole == "Admin" || Model.UserRole == "Manager" || Model.UserRole == "Technician")
                                {
                                    <form method="post" asp-page-handler="UpdatePriority" asp-route-ticketId="@Model.Ticket.Id" class="ff-status-form meta-value">
                                        <select asp-for="SelectedPriorityCode" asp-items="Model.AvailablePriorities" class="fsel ff-status-select js-auto-submit-select" aria-label="Ticket priority"></select>
                                    </form>
                                }
                                else
                                {
                                    <span class="priority-text @Model.Ticket.Priority.ToLower()">
                                        @Model.Ticket.Priority
                                    </span>
                                }
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">Category</span>
                                <span class="meta-value">@Model.Ticket.Category</span>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label">Location</span>
                                <span class="meta-value">@Model.Ticket.Building, Room @Model.Ticket.RoomNumber</span>
                            </div>
                        </div>

                        <div class="ticket-description">
                            <strong>Description:</strong><br />
                            @Model.Ticket.Description
                        </div>

                        @if (Model.UserRole != "Client" || Model.IsOwnTicket)
                        {
                            <div class="details-actions mt-6">
                                @if (((Model.UserRole == "Manager") || (Model.UserRole == "Technician")) && (Model.Ticket.Status == "Submitted" || Model.Ticket.Status == "Assigned"))
                                {
                                    <form method="post" asp-page-handler="AssignTechnician" asp-route-ticketId="@Model.Ticket.Id" class="ff-form-inline-flex">
                                        <select asp-for="SelectedTechnicianId" asp-items="Model.AvailableTechnicians" class="form-control ff-select-auto"></select>
                                        <button type="submit" class="btn btn-p">@(Model.Ticket.Status == "Assigned" ? "Reassign Technician" : "Assign Technician")</button>
                                    </form>
                                }
                                @if (Model.UserRole == "Technician" && Model.Ticket.Status == "Assigned")
                                {
                                        <form method="post" asp-page-handler="StartWork" asp-route-ticketId="@Model.Ticket.Id" class="ff-form-inline-flex">
                                            <button type="submit" class="btn btn-p">
                                                Start Work
                                            </button>

                                        </form>
                                }
                                @if (Model.UserRole == "Technician" && Model.Ticket.Status == "In Progress")
                                {
                                        <form method="post" asp-page-handler="MarkComplete" asp-route-ticketId="@Model.Ticket.Id" class="ff-form-inline-flex">
                                            <button type="submit" class="btn btn-p">
                                                Mark Complete
                                            </button>
                                        </form>
                                }
                                    @if (Model.UserRole == "Manager" && Model.Ticket.Status == "Complete")
                                    {
                                        <form method="post" asp-page-handler="MarkClosed" asp-route-ticketId="@Model.Ticket.Id" class="ff-form-inline-flex">
                                            <button type="submit" class="btn btn-p">
                                                Close Request
                                            </button>
                                        </form>
                                    }

                                // This was the edit ticket button. Dont think we need this
@*                                 @if (Model.UserRole == "Manager" || Model.UserRole == "Admin" || Model.UserRole == "Technician")
                                {
                                    <a asp-page="./Edit" asp-route-id="@Model.Ticket.Id" class="details-action-icon" aria-label="Edit ticket" title="Edit ticket">
                                        <i class="bi bi-pencil-square" aria-hidden="true"></i>
                                    </a>
                                } *@

                                @if (Model.UserRole == "Admin")
                                {
                                    <button type="button" class="details-action-icon" aria-label="Delete ticket" title="Delete ticket">
                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                    </button>
                                }
                            </div>
                        }
                        </div>
                    </section>

                    <section class="tsec details-card">
                        <div class="tsec-hd card-header">
                            <h3 class="card-title">Comments & Updates</h3>
                            <form method="post" asp-page-handler="SummarizeComments">
                                <input type="hidden" name="ticketId" value="@Model.Ticket.Id" />
                                <button type="submit" class="btn btn-s"><i class="bi bi-stars"></i> Summarize comments</button>
                            </form>
                        </div>

                        <div class="details-card-body">
                            @if (!string.IsNullOrWhiteSpace(Model.AISummary.NoteText))
                            {
                                <div class="summary-stub" role="status" aria-live="polite">
                                    <div class="summary-stub-title">Comment History Summary (AI Generated)</div>
                                    <p>@Model.AISummary.NoteText</p>
                                </div>
                            }
                            else
                            {
                                <div class="summary-placeholder">
                                    <p>Click Summarize comments for a summary.</p>
                                </div>
                            }

                            @foreach (var comment in Model.TicketNotes)
                            {
                                <div class="comment">
                                    <div class="comment-header">
                                        <div class="comment-author">
                                            @comment.EnteredByUserName

                                        </div>
                                        <span>@comment.TimeStamp.ToString()</span>
                                    </div>
                                    <div class="comment-text">@comment.NoteText</div>
                                </div>
                            }

                            @if (Model.TicketNotes.Count == 0)
                            {
                                <div class="empty-state">
                                    <i class="bi bi-chat ff-empty-icon" aria-hidden="true"></i>
                                    <p>No comments yet</p>
                                </div>
                            }

                            <div class="comment-form">
                                <form method="post" asp-page-handler="AddComment">
                                    <input type="hidden" name="ticketId" value="@Model.Ticket.Id" />

                                    <div class="form-group">
                                        <label>Add a comment</label>
                                        <textarea class="fta" name="commentText" required></textarea>
                                    </div>

                                    @if ((Model.UserRole != "Client") && (Model.UserRole != "Pending"))
                                    {
                                        <div class="ff-comment-toggle-row">
                                            <input type="checkbox" name="internalOnly" value="true" checked />
                                            <label>Internal Only</label>
                                        </div>
                                    }
                                    <input type="hidden" name="internalOnly" value="false" />

                                    <button type="submit" class="btn btn-p"><i class="bi bi-send"></i> Post Comment</button>
                                </form>
                            </div>
                        </div>
                    </section>

@*                     @if (Model.UserRole != "Client")
                    {
                        <section class="tsec details-card">
                            <div class="tsec-hd card-header">
                                <h3 class="card-title">Internal Notes</h3>
                                <span class="text-muted text-sm">Not visible to clients</span>
                            </div>
                            <div class="details-card-body">
                            @foreach (var note in Model.InternalNotes)
                            {
                                <div class="comment internal">
                                    <div class="comment-header">
                                        <div class="comment-author">
                                            @note.AuthorName
                                            <span class="comment-badge">@note.AuthorRole</span>
                                        </div>
                                        <span>@note.CreatedDate.ToString("MMM dd, yyyy h:mm tt")</span>
                                    </div>
                                    <div class="comment-text">@note.Text</div>
                                </div>
                            }

                            @if (!Model.InternalNotes.Any())
                            {
                                <div class="empty-state">
                                    <i class="bi bi-sticky ff-empty-icon" aria-hidden="true"></i>
                                    <p>No internal notes yet</p>
                                </div>
                            }

                            <div class="comment-form">
                                <form method="post" asp-page-handler="AddInternalNote">
                                    <input type="hidden" name="ticketId" value="@Model.Ticket.Id" />
                                    <div class="form-group">
                                        <label>Add internal note</label>
                                        <textarea class="fta" name="noteText" placeholder="This will only be visible to staff..." required></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-s"><i class="bi bi-sticky"></i> Add Note</button>
                                </form>
                            </div>
                            </div>
                        </section>
                    } *@
                </div>

                <div>
                    <section class="tsec details-card">
                        <div class="tsec-hd card-header">
                            <h3 class="card-title">Ticket Information</h3>
                        </div>
                        <div class="details-card-body">
                        <div class="info-list">
                            <div class="info-item">
                                <span class="info-label">Submitted By</span>
                                <span class="info-value">@Model.Ticket.SubmittedBy</span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">Created</span>
                                <span class="info-value">@((Model.Ticket.CreatedDate == DateTime.MinValue) ? "-" : Model.Ticket.CreatedDate.ToString("MMM dd, yyyy"))</span>
                            </div>
                            @if (Model.Ticket.AssignedTo != null)
                            {
                                <div class="info-item">
                                    <span class="info-label">Assigned To</span>
                                    <span class="info-value">@Model.Ticket.AssignedTo</span>
                                </div>
                            }
                            @if (Model.Ticket.DueDate != null)
                            {
                                <div class="info-item">
                                    <span class="info-label">Due Date</span>
                                    <span class="info-value">@Model.Ticket.DueDate?.ToString("MMM dd, yyyy")</span>
                                </div>
                            }
                            @if (Model.Ticket.CompletedDate != null)
                            {
                                <div class="info-item">
                                    <span class="info-label">Completed</span>
                                    <span class="info-value">@Model.Ticket.CompletedDate?.ToString("MMM dd, yyyy")</span>
                                </div>
                            }
                        </div>
                        </div>
                    </section>

                    <section class="tsec details-card">
                        <div class="tsec-hd card-header">
                            <h3 class="card-title">Activity History</h3>
                        </div>
                        <div class="details-card-body">
                        <div class="timeline">
                            @foreach (var activity in Model.ActivityHistory)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-title">@activity.Action</div>
                                    <div class="timeline-details">
                                        @activity.PerformedBy · @activity.Timestamp.ToString("MMM dd, h:mm tt")
                                    </div>
                                </div>
                            }

                            @if (!Model.ActivityHistory.Any())
                            {
                                <div class="empty-state">
                                    <i class="bi bi-folder2-open ff-empty-icon" aria-hidden="true"></i>
                                    <p>No activity yet</p>
                                </div>
                            }
                        </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </main>
</div>